{
  "name": "htech-digital-solutions/htech-leadflow",
  "description": "Self-hosted WordPress lead capture and management",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.1" },
  "require-dev": {
    "phpunit/phpunit": "^10.5.62",
    "wp-coding-standards/wpcs": "^3.3",
    "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }, "sort-packages": true, "platform": { "php": "8.1.34" } },
  "minimum-stability": "alpha",
  "prefer-stable": true
}
